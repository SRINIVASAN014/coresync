# ==========================================
# CoreSync Environment Variables Configuration
# ==========================================

# 1. Database Configuration (PostgreSQL)
# Recommended free tier: https://neon.tech
DATABASE_URL="postgresql://username:password@ep-cool-project-123456.us-east-2.aws.neon.tech/coresync_db?sslmode=require"

# 2. Authentication Configuration (NextAuth.js)
# URL where your app is running
NEXTAUTH_URL="http://localhost:3000"
# Generate a secure secret using: openssl rand -base64 32 or any 32+ character random string
NEXTAUTH_SECRET="your-super-secret-jwt-key-replace-with-a-random-32-char-string"

# 3. OAuth Providers (Optional for local development)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# 4. AI Provider Configuration
# Get a free Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# (Optional) OpenAI API Key if using OpenAI fallback
OPENAI_API_KEY=""
